# =====================================================
# Supabase — tạo project miễn phí tại supabase.com
# =====================================================

# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon key (public, dùng cho frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (private, chỉ dùng phía server để ghi DB)
# KHÔNG đặt tiền tố NEXT_PUBLIC — không để lộ key này ra client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# Cron Secret — Vercel tự set khi deploy
# Để test local, set giá trị tùy ý
# =====================================================
CRON_SECRET=your-secret-here
